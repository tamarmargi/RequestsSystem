{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "OnStartupIfEmpty": false
  },
  "Cache": {
    "StatsSeconds": 60
  },
  "AllowedHosts": "*"
}
